<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="595.0" prefWidth="951.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferreteria.controllers.CarritoController">

    <children>

        <Label layoutX="380.0" layoutY="25.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="MI CARRITO DE COMPRAS" />

        <ScrollPane fitToWidth="true" layoutX="62.0" layoutY="130.0" prefHeight="390.0" prefWidth="900.0">

            <content>
                <VBox fx:id="panelCarrito" prefWidth="850.0" spacing="15.0" style="-fx-padding: 15px;" />
            </content>

        </ScrollPane>

        <Label fx:id="lblTotal" layoutX="616.0" layoutY="67.0" style="-fx-font-size: 22px; -fx-font-weight: bold;" text="TOTAL: $0" />

        <Button layoutX="80.0" layoutY="99.0" onAction="#volverCatalogo" prefWidth="200.0" text="VOLVER AL CATÁLOGO" />
        
        <Button layoutX="320.0" layoutY="538.0" onAction="#finalizarCompra" prefWidth="200.0" text="FINALIZAR COMPRA" />
<Button layoutX="561.0" layoutY="99.0" onAction="#finalizarCompra" prefWidth="200.0" text="FINALIZAR COMPRA" />
        <Button layoutX="331.0" layoutY="99.0" onAction="#vaciarCarrito" prefWidth="200.0" text="VACIAR CARRITO" />

    </children>
</AnchorPane>
