<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="700.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.CompraController">

    <children>

        <Label layoutX="210.0"
               layoutY="60.0"
               text="FINALIZAR COMPRA"
               style="-fx-font-size: 26px; -fx-font-weight: bold;"/>

        <Label layoutX="180.0"
               layoutY="160.0"
               text="Confirma los datos de tu compra."
               style="-fx-font-size: 17px;"/>

        <Label fx:id="lblTotal"
               layoutX="200.0"
               layoutY="230.0"
               text="TOTAL A PAGAR: $0"
               style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

        <Button layoutX="150.0"
                layoutY="330.0"
                prefWidth="180.0"
                prefHeight="45.0"
                text="CONFIRMAR COMPRA"
                onAction="#confirmarCompra"/>

        <Button layoutX="370.0"
                layoutY="330.0"
                prefWidth="180.0"
                prefHeight="45.0"
                text="VOLVER AL CARRITO"
                onAction="#cancelarCompra"/>

    </children>
</AnchorPane>