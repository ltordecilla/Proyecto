<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.DeseosController"
            prefWidth="1000" prefHeight="650"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox spacing="10"
              style="-fx-background-color: #263238; -fx-padding: 20;">
            <Label text="MI LISTA DE DESEOS"
                   style="-fx-text-fill: white; -fx-font-size: 25px; -fx-font-weight: bold;"/>
            <Label text="Tus productos favoritos"
                   style="-fx-text-fill: #cfd8dc; -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color: transparent;">
            <content>
                <FlowPane fx:id="panelDeseos"
                          hgap="20" vgap="20"
                          alignment="TOP_LEFT"
                          style="-fx-padding: 25;"/>
            </content>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="15"
              style="-fx-padding: 20;">
            <Button text="VOLVER AL MENÚ"
                    onAction="#volverMenu"
                    style="-fx-background-color: #263238;
                           -fx-text-fill: white;
                           -fx-font-weight: bold;
                           -fx-padding: 12 20;"/>
        </HBox>
    </bottom>

</BorderPane>
