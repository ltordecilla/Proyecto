<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="650.0"
            prefWidth="1100.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.HistorialAdminController">

    <children>

        <Label layoutX="350.0"
               layoutY="25.0"
               text="HISTORIAL GENERAL DE COMPRAS"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;"/>

        <Label layoutX="40.0"
               layoutY="75.0"
               text="Todas las compras realizadas por los clientes"
               style="-fx-font-size: 14px;
                      -fx-text-fill: #666666;"/>

        <TableView fx:id="tablaHistorial"
                   layoutX="30.0"
                   layoutY="115.0"
                   prefWidth="1040.0"
                   prefHeight="420.0">

            <columns>

                <TableColumn fx:id="colNumero"
                             text="N.º COMPRA"
                             prefWidth="90.0"/>

                <TableColumn fx:id="colCliente"
                             text="NOMBRE DEL CLIENTE"
                             prefWidth="190.0"/>

                <TableColumn fx:id="colUsuario"
                             text="USUARIO"
                             prefWidth="130.0"/>

                <TableColumn fx:id="colFecha"
                             text="FECHA"
                             prefWidth="160.0"/>

                <TableColumn fx:id="colProductos"
                             text="PRODUCTOS COMPRADOS"
                             prefWidth="290.0"/>

                <TableColumn fx:id="colTotal"
                             text="TOTAL PAGADO"
                             prefWidth="170.0"/>

            </columns>

        </TableView>

        <Button layoutX="350.0"
                layoutY="570.0"
                prefWidth="180.0"
                prefHeight="40.0"
                text="VER DETALLE"
                onAction="#verDetalle"
                style="-fx-background-color: #ff7900;
                       -fx-text-fill: white;
                       -fx-font-weight: bold;"/>

        <Button layoutX="550.0"
                layoutY="570.0"
                prefWidth="180.0"
                prefHeight="40.0"
                text="VOLVER AL MENÚ"
                onAction="#volverMenu"/>

    </children>

</AnchorPane>
