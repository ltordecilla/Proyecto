<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="600.0"
            prefWidth="1000.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.HistorialClienteController">

    <children>

        <Label layoutX="350.0"
               layoutY="25.0"
               text="MI HISTORIAL DE COMPRAS"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;"/>

        <TableView fx:id="tablaHistorial"
                   layoutX="40.0"
                   layoutY="100.0"
                   prefWidth="920.0"
                   prefHeight="350.0">

            <columns>

                <TableColumn fx:id="colNumero"
                             text="N.º COMPRA"
                             prefWidth="120.0"/>

                <TableColumn fx:id="colFecha"
                             text="FECHA"
                             prefWidth="200.0"/>

                <TableColumn fx:id="colProductos"
                             text="PRODUCTOS COMPRADOS"
                             prefWidth="400.0"/>

                <TableColumn fx:id="colTotal"
                             text="TOTAL PAGADO"
                             prefWidth="200.0"/>

            </columns>

        </TableView>

        <Button layoutX="350.0"
                layoutY="490.0"
                prefWidth="150.0"
                text="VER DETALLE"
                onAction="#verDetalle"/>

        <Button layoutX="520.0"
                layoutY="490.0"
                prefWidth="150.0"
                text="VOLVER AL MENÚ"
                onAction="#volverMenu"/>

    </children>

</AnchorPane>
