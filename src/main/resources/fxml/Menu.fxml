<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="601.0"
            prefWidth="615.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.MenuController">

    <children>

        <!-- IMAGEN DE FONDO -->
        <ImageView fitWidth="615.0"
                   fitHeight="601.0"
                   layoutX="0.0"
                   layoutY="0.0"
                   preserveRatio="false"
                   mouseTransparent="true">

            <image>
                <Image url="@../images/Hardware%20Store%20Workshop%20Display.png"/>
            </image>

        </ImageView>

        <!-- TITULO -->
        <Label layoutX="105.0"
               layoutY="35.0"
               prefWidth="405.0"
               prefHeight="40.0"
               text="SISTEMA DE FERRETERÍA"
               alignment="CENTER"
               style="-fx-font-size: 25px;
                      -fx-font-weight: bold;
                      -fx-text-fill: white;"/>

        <!-- BIENVENIDA -->
        <Label fx:id="lblBienvenida"
               layoutX="105.0"
               layoutY="82.0"
               prefWidth="405.0"
               prefHeight="30.0"
               text="Bienvenido"
               alignment="CENTER"
               style="-fx-font-size: 16px;
                      -fx-text-fill: white;"/>

        <!-- PANEL DE BOTONES -->
        <VBox layoutX="145.0"
              layoutY="130.0"
              prefWidth="325.0"
              spacing="12.0"
              style="-fx-padding: 15;
                     -fx-background-color: rgba(20,20,20,0.78);
                     -fx-background-radius: 10;">

            <children>

                <Button fx:id="btnProductos"
                        maxWidth="Infinity"
                        prefHeight="45.0"
                        text="GESTIÓN DE PRODUCTOS"
                        onAction="#abrirProductos"
                        styleClass="menu-button"/>

                <Button fx:id="btnVentas"
                        maxWidth="Infinity"
                        prefHeight="45.0"
                        text="REALIZAR VENTAS"
                        onAction="#abrirVentas"
                        styleClass="menu-button"/>

               
                <Button fx:id="btnHistorial"
                        maxWidth="Infinity"
                        prefHeight="45.0"
                        text="HISTORIAL DE COMPRAS"
                        onAction="#abrirHistorial"
                        styleClass="menu-button"/>

         
                <Button fx:id="btnReportes"
                        maxWidth="Infinity"
                        prefHeight="45.0"
                        text="REPORTES"
                        onAction="#abrirReportes"
                        styleClass="menu-button"/>

                <Button maxWidth="Infinity"
                        prefHeight="45.0"
                        text="VER CATÁLOGO DE PRODUCTOS"
                        onAction="#abrirCatalogo"
                        styleClass="menu-button"/>

                <Button fx:id="btnCerrarSesion"
                        maxWidth="Infinity"
                        prefHeight="45.0"
                        text="CERRAR SESIÓN"
                        onAction="#cerrarSesion"
                        styleClass="menu-button"/>

            </children>
        </VBox>

    </children>

    <!-- CONEXIÓN CON CSS -->
    <stylesheets>
        <URL value="@../css/menu.css"/>
    </stylesheets>

</AnchorPane>
