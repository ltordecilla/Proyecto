<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="525.0"
            prefWidth="631.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.MenuClienteController">

    <children>

        <!-- IMAGEN DE FONDO -->
        <ImageView fitHeight="525.0"
                   fitWidth="631.0"
                   layoutX="0.0"
                   layoutY="0.0"
                   preserveRatio="false"
                   mouseTransparent="true">

            <image>
                <Image url="@../images/Hardware%20Store%20Workshop%20Display.png"/>
            </image>

        </ImageView>

        <!-- PANEL DEL MENÚ -->
        <VBox alignment="CENTER"
              layoutX="76.0"
              layoutY="65.0"
              prefWidth="480.0"
              spacing="20.0"
              style="-fx-padding: 30;
                     -fx-background-color: rgba(20,20,20,0.78);
                     -fx-background-radius: 12;">

            <children>

                <Label text="MENÚ DEL CLIENTE"
                       style="-fx-font-size: 25px;
                              -fx-font-weight: bold;
                              -fx-text-fill: white;"/>

                <Button onAction="#abrirCatalogo"
                        prefHeight="45.0"
                        prefWidth="320.0"
                        text="VER CATÁLOGO DE PRODUCTOS"/>

                <Button onAction="#abrirCarrito"
                        prefHeight="45.0"
                        prefWidth="320.0"
                        text="MI CARRITO"/>

                <Button onAction="#abrirDeseos"
                        prefHeight="45.0"
                        prefWidth="320.0"
                        text="MI LISTA DE DESEOS"/>

                <Button onAction="#abrirHistorial"
                        prefHeight="45.0"
                        prefWidth="320.0"
                        text="MI HISTORIAL DE COMPRAS"/>

                <Button onAction="#cerrarSesion"
                        prefHeight="45.0"
                        prefWidth="320.0"
                        text="CERRAR SESIÓN"
                        style="-fx-background-color: #c62828;
                               -fx-text-fill: white;"/>

            </children>
        </VBox>

    </children>

</AnchorPane>

