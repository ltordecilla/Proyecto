<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="515.0" prefWidth="766.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferreteria.controllers.ProductosController">

    <children>
      <ImageView fitHeight="513.0" fitWidth="803.0" layoutY="2.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/login.jpg" />
         </image>
      </ImageView>

        <Label layoutX="350.0" layoutY="20.0" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="GESTIÓN DE PRODUCTOS" />

              <Label layoutX="40.0" layoutY="85.0" text="Código:" />
        <TextField fx:id="txtCodigo" layoutX="120.0" layoutY="80.0" prefWidth="250.0" promptText="Código del producto" />

        <Label layoutX="40.0" layoutY="135.0" text="Nombre:" />
        <TextField fx:id="txtNombre" layoutX="120.0" layoutY="130.0" prefWidth="250.0" promptText="Nombre del producto" />

        <Label layoutX="40.0" layoutY="185.0" text="Categoría:" />
        <ComboBox fx:id="cmbCategoria" layoutX="120.0" layoutY="180.0" prefWidth="250.0" promptText="Seleccione categoría" />

        <Label layoutX="420.0" layoutY="85.0" text="Precio:" />
        <TextField fx:id="txtPrecio" layoutX="490.0" layoutY="80.0" prefWidth="200.0" promptText="Precio" />

        <Label layoutX="420.0" layoutY="135.0" text="Stock:" />
        <TextField fx:id="txtStock" layoutX="490.0" layoutY="130.0" prefWidth="200.0" promptText="Cantidad disponible" />

        <Button layoutX="14.0" layoutY="471.0" onAction="#agregarProducto" prefWidth="180.0" text="AGREGAR" />

        <Button layoutX="210.0" layoutY="473.0" onAction="#modificarProducto" prefWidth="180.0" text="MODIFICAR" />

        <Button layoutX="400.0" layoutY="473.0" onAction="#eliminarProducto" prefWidth="180.0" text="ELIMINAR" />

        <Button layoutX="580.0" layoutY="473.0" onAction="#limpiarCampos" prefWidth="180.0" text="LIMPIAR" />

        <TableView fx:id="tablaProductos" layoutX="14.0" layoutY="290.0" prefHeight="181.0" prefWidth="741.0">

            <columns>
                <TableColumn fx:id="colCodigo" prefWidth="84.0" text="Código" />
                <TableColumn fx:id="colNombre" prefWidth="200.0" text="Nombre" />
                <TableColumn fx:id="colCategoria" prefWidth="117.0" text="Categoría" />
                <TableColumn fx:id="colPrecio" minWidth="0.0" prefWidth="112.0" text="Precio" />
                <TableColumn fx:id="colStock" prefWidth="377.0" text="Stock" />
                <TableColumn fx:id="colImagen" prefWidth="100.0" text="Imagen" />
            </columns>
        </TableView>

        <Button layoutX="120.0" layoutY="240.0" onAction="#volverMenu" prefWidth="200.0" text="VOLVER AL MENÚ" />
<ImageView fx:id="imgProducto" fitHeight="104.0" fitWidth="170.0" layoutX="520.0" layoutY="168.0" preserveRatio="true" />

<Button layoutX="366.0" layoutY="240.0" onAction="#seleccionarImagen" text="SELECCIONAR IMAGEN" />
    </children>
</AnchorPane>
