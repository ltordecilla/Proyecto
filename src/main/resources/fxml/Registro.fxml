<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="497.0" prefWidth="541.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.ferreteria.controllers.RegistroController">

    <children>
      <ImageView fitHeight="537.0" fitWidth="615.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../images/Hardware%20Store%20Workshop%20Display.png" />
         </image>
      </ImageView>

        <TextField fx:id="txtNombre" layoutX="150.0" layoutY="104.0" prefHeight="25.0" prefWidth="243.0" promptText="Nombre completo" />

        <TextField fx:id="txtIdentificacion" layoutX="150.0" layoutY="152.0" prefHeight="25.0" prefWidth="243.0" promptText="Identificación" />

        <TextField fx:id="txtCorreo" layoutX="150.0" layoutY="207.0" prefHeight="25.0" prefWidth="243.0" promptText="Correo electrónico" />

        <TextField fx:id="txtTelefono" layoutX="150.0" layoutY="263.0" prefHeight="25.0" prefWidth="243.0" promptText="Teléfono" />

        <TextField fx:id="txtUsuario" layoutX="150.0" layoutY="318.0" prefHeight="25.0" prefWidth="243.0" promptText="Nombre de usuario" />

        <PasswordField fx:id="txtContrasena" layoutX="150.0" layoutY="371.0" prefHeight="25.0" prefWidth="243.0" promptText="Contraseña" />

        <PasswordField fx:id="txtConfirmar" layoutX="150.0" layoutY="412.0" prefHeight="25.0" prefWidth="243.0" promptText="Confirmar contraseña" />
      <AnchorPane layoutX="-173.0" prefHeight="537.0" prefWidth="615.0">
         <children>
      
              <Button fx:id="btnVolver" layoutX="309.0" layoutY="458.0" onAction="#volver" text="VOLVER AL LOGIN" />
      
              <Button fx:id="btnRegistrar" layoutX="462.0" layoutY="458.0" onAction="#registrar" text="REGISTRAR" />
         </children>
      </AnchorPane>

    </children>
</AnchorPane>
