<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.ReportesController"
            prefWidth="1000"
            prefHeight="650"
            style="-fx-background-color: #f4f6f9;">

    <top>
        <VBox spacing="8"
              style="-fx-background-color: #263238; -fx-padding: 20;">

            <Label text="REPORTES DEL SISTEMA"
                   style="-fx-text-fill: white;
                          -fx-font-size: 25px;
                          -fx-font-weight: bold;"/>

            <Label text="Estadísticas y control del inventario"
                   style="-fx-text-fill: #cfd8dc;
                          -fx-font-size: 14px;"/>
        </VBox>
    </top>

    <center>
        <VBox spacing="25"
              alignment="CENTER"
              style="-fx-padding: 30;">

            <Label text="REPORTE GENERAL DE INVENTARIO"
                   style="-fx-font-size: 22px;
                          -fx-font-weight: bold;"/>

            <GridPane hgap="20"
                      vgap="20"
                      alignment="CENTER">

                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      prefHeight="150"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="TOTAL DE PRODUCTOS"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblTotalProductos"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-text-fill: #263238;"/>
                </VBox>

                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      prefHeight="150"
                      GridPane.columnIndex="1"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="PRODUCTOS DISPONIBLES"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblDisponibles"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-text-fill: #2e7d32;"/>
                </VBox>

                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      prefHeight="150"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="PRODUCTOS AGOTADOS"
                           style="-fx-font-weight: bold;"/>

                    <Label fx:id="lblAgotados"
                           text="0"
                           style="-fx-font-size: 30px;
                                  -fx-text-fill: #c62828;"/>
                </VBox>

                <VBox spacing="15"
                      alignment="CENTER"
                      prefWidth="250"
                      prefHeight="150"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1"
                      style="-fx-background-color: white;
                             -fx-background-radius: 12;
                             -fx-padding: 20;">

                    <Label text="VALOR DEL INVENTARIO"
                           style="-fx-font-weight: bold;"/>

        <Label fx:id="lblValorInventario"
       style="-fx-font-size: 25px;
              -fx-text-fill: #1565c0;"/>
                </VBox>

            </GridPane>

            <HBox spacing="15" alignment="CENTER">

                <Button text="ACTUALIZAR"
                        onAction="#actualizarReporte"
                        style="-fx-background-color: #1565c0;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 12 20;"/>

                <Button text="EXPORTAR A PDF"
                        onAction="#exportarPDF"
                        style="-fx-background-color: #c62828;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 12 20;"/>

                <Button text="VOLVER AL MENÚ"
                        onAction="#volverMenu"
                        style="-fx-background-color: #263238;
                               -fx-text-fill: white;
                               -fx-font-weight: bold;
                               -fx-padding: 12 20;"/>

            </HBox>

        </VBox>
    </center>

</BorderPane>


