.menu-button {
    -fx-background-color: #292929;
    -fx-text-fill: white;
    -fx-font-size: 13px;
    -fx-font-weight: bold;
    -fx-border-color: #ff7900;
    -fx-border-width: 1.5px;
    -fx-background-radius: 7px;
    -fx-border-radius: 7px;
    -fx-cursor: hand;
}

.menu-button:hover {
    -fx-background-color: #ff7900;
    -fx-text-fill: white;
    -fx-border-color: white;
}

.menu-button:pressed {
    -fx-background-color: #cc5700;
}

