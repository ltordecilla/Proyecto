<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="550.0" prefWidth="900.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.ferreteria.controllers.LoginController">

    <children>

        <Label layoutX="350.0"
               layoutY="65.0"
               prefHeight="36.0"
               prefWidth="291.0"
               text="FERRETERÍA" />

        <TextField fx:id="txtUsuario"
                   layoutX="300.0"
                   layoutY="190.0"
                   prefWidth="300.0"
                   promptText="USUARIO" />

        <PasswordField fx:id="txtContrasena"
                       layoutX="300.0"
                       layoutY="250.0"
                       prefWidth="300.0"
                       promptText="CONTRASEÑA" />

        <Button fx:id="btnIngresar"
                layoutX="300.0"
                layoutY="330.0"
                prefWidth="300.0"
                text="INGRESAR"
                onAction="#ingresar" />

        <Button fx:id="btnRegistro"
                layoutX="300.0"
                layoutY="390.0"
                prefWidth="300.0"
                text="REGISTRARSE"
                onAction="#abrirRegistro" />

        <Button fx:id="btnSalir"
                layoutX="300.0"
                layoutY="450.0"
                prefWidth="300.0"
                text="SALIR"
                onAction="#salir" />

    </children>

</AnchorPane>
